# Android Studio emulator: 10.0.2.2 reaches the host computer.
# iOS simulator: use http://localhost:9000; devices: use the host LAN IP.
MEDUSA_BACKEND_URL=http://10.0.2.2:9000
# Medusa Admin publishable key linked to the products' sales channel.
# Leave empty for unit tests; required to connect to a real store.
PUBLISHABLE_API_KEY=
# Supported: en-US, id-ID. A saved app locale overrides this value.
DEFAULT_LOCALE=en-US
